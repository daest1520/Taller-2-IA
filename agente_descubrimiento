import torch
import torch.nn as nn

class ComponenteDescubrimiento(nn.Module):
    def __init__(self, state_dim, action_dim):
        super(ComponenteDescubrimiento, self).__init__()
        # Extrae características del estado
        self.encoder = nn.Sequential(
            nn.Linear(state_dim, 32),
            nn.ReLU(),
            nn.Linear(32, 16)
        )
        # Predice el futuro basado en estado + acción
        self.forward_model = nn.Sequential(
            nn.Linear(16 + action_dim, 32),
            nn.ReLU(),
            nn.Linear(32, 16)
        )

    def forward(self, state, action_one_hot):
        phi_state = self.encoder(state)
        x = torch.cat([phi_state, action_one_hot], dim=-1)
        prediccion = self.forward_model(x)
        return phi_state, prediccion
